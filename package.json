{
  "name": "my-svelte-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest --run",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "HEADED=1 playwright test",
    "test:headed": "vitest --run --browser.headed",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
    "seed": "bun run src/scripts/seed.ts"
  },
  "devDependencies": {
    "@better-auth/cli": "~1.4.21",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.25.0",
    "@neondatabase/serverless": "^1.0.2",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@vitest/browser-playwright": "^4.1.3",
    "better-auth": "~1.6.13",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "layerchart": "2.0.0-next.48",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "vitest-browser-svelte": "^2.1.0",
    "wrangler": "^4.99.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@vercel/blob": "^2.4.1",
    "bcryptjs": "^3.0.3",
    "devalue": "^5.8.1",
    "dotenv": "^17.4.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "svelte-sonner": "^1.1.1",
    "xendit-node": "^7.0.0"
  }
}